    "cn": "0.2.6",
    "effect": "4.0.0-rc.113",
    "fumadocs-core": "16.15.9",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.9",
    "lucide-react": "1.45.0",
    "mermaid": "11.16.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.113",
