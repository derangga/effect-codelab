{
  "name": "learning-effect-app",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/post-build.ts",
    "start": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "preview": "vite preview",
    "types:check": "tsc --noEmit",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --format pretty",
    "check:content": "bun scripts/check-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.34",
    "@tanstack/react-router-devtools": "1.167.1",
