    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "gray-matter": "4.0.3",
    "jose": "6.2.12",
    "msw": "2.15.0",
    "oxlint": "1.82.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
